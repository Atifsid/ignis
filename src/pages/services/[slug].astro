---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageBanner from "../../components/PageBanner.astro";
import { company, services, tel, type Service } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const anchor = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<Base title={service.name} description={service.intro}>
  <PageBanner title={service.name} intro={service.intro} crumbs={[{ label: "Services", href: "/services" }]} />

  <div class="wrap layout section">
    <div class="systems">
      <h2>{service.systems.length} systems under {service.name.toLowerCase()}</h2>
      <ul>
        {
          service.systems.map((sys) => (
            <li class="system" id={anchor(sys.name)}>
              {sys.image && (
                <div class="system__media">
                  <Image src={sys.image} alt={sys.name} widths={[360, 640]} sizes="(min-width: 760px) 18rem, 100vw" />
                </div>
              )}
              <div>
                <h3>{sys.name}</h3>
                <p>{sys.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="aside">
      <nav class="aside__box" aria-label="All services">
        <h2>All services</h2>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} aria-current={s.slug === service.slug ? "page" : undefined}>
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="aside__box aside__enquiry">
        <h2>Talk to an engineer</h2>
        <p>Tell us about your site and we'll suggest the right system and what it would take to install.</p>
        <a class="btn btn--white" href={`/contact?service=${encodeURIComponent(service.name)}`}>Send an enquiry</a>
        <a class="aside__phone" href={tel(company.phones[0])}>
          <i class="ri-phone-fill" aria-hidden="true"></i>{company.phones[0]}
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 4rem;
      align-items: start;
    }
  }

  .systems > h2 {
    margin-bottom: 2rem;
    font-size: var(--t-h3);
  }
  .systems ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .system {
    display: grid;
    gap: 1.25rem 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 6rem;
  }
  .system:target h3 {
    color: var(--red);
  }
  @media (min-width: 760px) {
    .system {
      grid-template-columns: 18rem minmax(0, 1fr);
      align-items: center;
    }
  }
  .system__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--concrete);
    border-radius: var(--radius);
  }
  .system__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .system h3 {
    margin-bottom: 0.5rem;
  }
  .system p {
    max-width: 34em;
    color: var(--steel);
    font-size: var(--t-lead);
    line-height: 1.5;
  }

  .aside {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1000px) {
    .aside {
      position: sticky;
      top: 6.5rem;
    }
  }
  .aside__box {
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .aside__box h2 {
    margin-bottom: 1rem;
    font-size: var(--t-h4);
    font-weight: 700;
  }
  .aside__box ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aside__box li a {
    display: block;
    padding: 0.6rem 0 0.6rem 0.9rem;
    border-left: 3px solid var(--rule);
    text-decoration: none;
    font-weight: 550;
  }
  .aside__box li a:hover {
    color: var(--red);
  }
  .aside__box li a[aria-current="page"] {
    border-left-color: var(--red);
    color: var(--red);
    font-weight: 700;
  }
  .aside__enquiry {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .aside__enquiry p {
    margin-bottom: 1.25rem;
    color: #b9c0c6;
  }
  .aside__phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-weight: 650;
    text-decoration: none;
  }
  .aside__phone i {
    color: #ff6b6b;
  }
</style>
