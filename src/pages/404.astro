---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="section">
    <div class="wrap notfound">
      <h1>This page doesn't exist</h1>
      <p class="lead">The link may be old, or the address mistyped. Try one of these instead.</p>
      <div class="notfound__actions">
        <a class="btn btn--red" href="/">Go to the home page</a>
        <a class="btn btn--ink-line" href="/services">See our services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
