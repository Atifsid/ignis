---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import Process from "../components/Process.astro";
import Industries from "../components/Industries.astro";
import { capabilities, certifications, clients, company } from "../data/site";
---

<Base>
  <Hero />

  <section class="section intro">
    <div class="wrap intro__grid">
      <div>
        <h2>One firm for the whole life of your fire protection</h2>
      </div>
      <div class="intro__text">
        <p class="lead">{company.about}</p>
        <p>
          We design, develop, conduct safety audits and training, provide project management consultancy, execute
          turnkey projects and manage fire systems year after year.
        </p>
        <a class="text-link" href="/about">More about Ignis <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
      </div>
    </div>

    <ul class="wrap capabilities">
      {
        capabilities.map((c) => (
          <li>
            <i class={c.icon} aria-hidden="true" />
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section section--concrete">
    <div class="wrap">
      <div class="section-head">
        <h2>Systems we design, install and service</h2>
        <p class="lead">
          Water-based fire fighting, gas and mist suppression, detection and alarm, plus the testing and upkeep that keeps
          them ready.
        </p>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <Process />

  <Industries />

  {
    (clients.length > 0 || certifications.length > 0) && (
      <section class="section trust">
        <div class="wrap trust__grid">
          {certifications.length > 0 && (
            <div>
              <h2>Certifications</h2>
              <ul class="trust__certs">
                {certifications.map((c) => (
                  <li>
                    <strong>{c.name}</strong>
                    <span>{c.detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {clients.length > 0 && (
            <div>
              <h2>Clients we work with</h2>
              <ul class="trust__clients">
                {clients.map((name) => (
                  <li>{name}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  .intro__grid {
    display: grid;
    gap: 1.5rem 4rem;
  }
  @media (min-width: 900px) {
    .intro__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  .intro h2 {
    max-width: 12em;
  }
  .intro__text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .intro__text p:not(.lead) {
    max-width: 38em;
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem 3rem;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    margin-bottom: 0;
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .capabilities i {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 2rem;
    line-height: 1;
    color: var(--red);
  }
  .capabilities h3 {
    margin-bottom: 0.4rem;
    font-size: var(--t-h4);
    font-weight: 700;
  }
  .capabilities p {
    color: var(--steel);
    max-width: 26em;
  }

  .trust__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .trust__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .trust h2 {
    margin-bottom: 1.5rem;
  }
  .trust ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust__certs li {
    display: grid;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }
  .trust__certs span {
    color: var(--steel);
  }
  .trust__clients {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .trust__clients li {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-weight: 600;
  }
</style>
